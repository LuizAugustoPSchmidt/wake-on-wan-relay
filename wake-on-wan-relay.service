[Unit]
Description=Wake-on-WAN TLS Relay
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=/opt/wake-on-wan-relay
ExecStart=/opt/wake-on-wan-relay/build/server
Restart=on-failure
RestartSec=5
User=nobody
Group=nogroup

[Install]
WantedBy=multi-user.target
